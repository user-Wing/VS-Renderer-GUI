+
+FFFResult PlayerVideoRenderer::SetCustomShader(const char* path, std::uint32_t width, std::uint32_t height) noexcept {
+    try {
+        std::lock_guard lock(deviceMutex_);
+        // Before the new source's first frame, cached colour fields may still
+        // describe the previous media. DrawCachedVideo validates the actual frame.
+        if (path && *path && (colorEngine_.settings.engine ||
+            projection360Enabled_.load(std::memory_order_acquire) ||
+            (hasCachedVideo_ && (decodedTransfer_.load(std::memory_order_acquire) != 0 ||
+                cachedVideoSettings_.gamut != 0 || actualMode_ != FFF3FPColorMode::MapToSdr ||
+                cachedTransformEnabled_)))) {
+            SetError("Custom HLSL currently supports SDR BT.709 native-colour playback without colour transforms or 360 projection; use the GLSL fallback for this source.");
+            return FFFResult::NotSupported;
+        }
+        vsr::shader::Pipeline candidate;
+        if (!candidate.load(path, width, height, device_)) {
+            SetError(candidate.error());
+            return FFFResult::InvalidArgument;
+        }
+        // Redraw is asynchronous. Validate the replacement on the cached frame
+        // before committing it, so size/WHEN/binding failures keep the old shader.
+        if (candidate.active() && hasCachedVideo_ && device_ && context_) {
+            auto* input = candidate.input(device_, sourceWidth_, sourceHeight_);
+            const auto targetWidth = std::max(1u, lastDestWidth_.load());
+            const auto targetHeight = std::max(1u, lastDestHeight_.load());
+            if (!input || DrawWithShader(input, 0, 0, float(sourceWidth_), float(sourceHeight_), 0) != FFFResult::Success ||
+                !candidate.process(context_, targetWidth, targetHeight)) {
+                SetError(candidate.error().empty() ? "Custom shader preflight failed." : candidate.error());
+                return FFFResult::InvalidArgument;
+            }
