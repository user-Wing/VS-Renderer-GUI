+FFFResult PlayerSession::SetAudioEffects(const bool enabled,const float* gains,const float wave,const std::int64_t delay) noexcept {
+    if(!gains || !std::isfinite(wave) || wave<0 || wave>1)return FFFResult::InvalidArgument;
