+        customShader_ = std::move(candidate);
+        scaledVideoGeneration_ = UINT64_MAX;
+        SetError({});
+        return FFFResult::Success;
+    } catch (...) {
+        SetError("Cannot load custom shader package.");
+        return FFFResult::NativeFailure;
+    }
+}
+
+FFFResult PlayerVideoRenderer::SetUpscaleShader(const char* path) noexcept {
+    try {
+        std::lock_guard lock(deviceMutex_);
+        vsr::shader::Pipeline candidate;
+        if (!candidate.load(path, 0, 0, device_)) { SetError(candidate.error()); return FFFResult::InvalidArgument; }
