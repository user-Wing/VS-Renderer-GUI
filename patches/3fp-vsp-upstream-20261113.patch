+
+FFFResult PlayerSession::SetScalingAlgorithms(const FFF3FPScalingAlgorithm upscale,
+    const FFF3FPScalingAlgorithm downscale) noexcept {
+    const auto result = videoRenderer_.SetScalingAlgorithms(upscale, downscale);
+    if (result != FFFResult::Success) return result;
+    const auto redrawResult = videoRenderer_.Redraw();
+    return redrawResult == FFFResult::InvalidState ? FFFResult::Success : redrawResult;
+}
+
+FFFResult PlayerSession::SetCustomShader(const char* path, std::uint32_t width, std::uint32_t height) noexcept {
+    const auto result = videoRenderer_.SetCustomShader(path, width, height);
+    if (result != FFFResult::Success) {
+        ReportError(result, videoRenderer_.LastError(), "CustomShader");
+        return result;
+    }
+    { std::lock_guard lock(errorMutex_); lastError_.clear(); }
+    const auto redrawResult = videoRenderer_.Redraw();
+    if (redrawResult != FFFResult::Success && redrawResult != FFFResult::InvalidState)
+        ReportError(redrawResult, videoRenderer_.LastError(), "CustomShader");
+    return redrawResult == FFFResult::InvalidState ? FFFResult::Success : redrawResult;
+}
+
+FFFResult PlayerSession::SetExternalOutputFormat(const char* format) noexcept {
+    const auto value = !format || !*format ? AV_PIX_FMT_NONE : av_get_pix_fmt(format);
+    if (format && *format && (value == AV_PIX_FMT_NONE || !sws_isSupportedOutput(value))) return FFFResult::NotSupported;
+    externalOutputFormat_.store(static_cast<int>(value));
+    return FFFResult::Success;
+}
