+enum class FFF3FPExternalPixelFormat : std::uint32_t {
+    Gray8 = 1,
+    Gray16 = 2,
+    Yuv420P8 = 10,
+    Yuv420P10 = 11,
+    Yuv420P12 = 12,
+    Yuv420P16 = 13,
+    Yuv422P8 = 20,
+    Yuv422P10 = 21,
