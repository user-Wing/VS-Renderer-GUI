+// The resample cache follows the total inspection zoom, not merely the fitted
+// viewport. Until this extent reaches the native frame size every zoom step is
+// still a downscale from the source; only the remainder beyond native density
+// is reconstructed by the selected upscale filter.
+constexpr std::uint32_t CalculateZoomSamplingExtent(const std::uint32_t fittedExtent,
+    const float zoom) noexcept {
+    return std::max(1u, static_cast<std::uint32_t>(
+        static_cast<float>(fittedExtent) * std::clamp(zoom, 0.05f, 64.0f) + 0.5f));
+}
