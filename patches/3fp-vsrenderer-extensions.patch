+    Yuv444P16 = 33,
+    GbrP8 = 40,
+    GbrP10 = 41,
+    GbrP12 = 42,
+    GbrP16 = 43,
+};
+
+// Version 1 CPU frame descriptor for frame servers such as VapourSynth.
+// Plane memory only has to remain valid until SubmitExternalVideoFrame returns;
+// the renderer uploads/copies the complete frame before returning.
+struct FFF3FPExternalVideoFrame {
+    std::uint32_t size;
+    std::uint32_t version;
+    std::uint32_t width;
+    std::uint32_t height;
+    FFF3FPExternalPixelFormat format;
+    std::uint32_t colorRange;      // 0=unspecified, 1=limited, 2=full
+    std::uint32_t colorPrimaries;  // H.273/AVColorPrimaries value
+    std::uint32_t colorTransfer;   // H.273/AVColorTransferCharacteristic value
+    std::uint32_t colorMatrix;     // H.273/AVColorSpace value
+    std::uint32_t chromaLocation;  // AVChromaLocation value, 0=unspecified
+    const void* data[4];
+    std::int32_t linesize[4];
+    std::int64_t frameIndex;
+    std::int64_t duration100ns;
+    std::int64_t totalFrames;
+};
