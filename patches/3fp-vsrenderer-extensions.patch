+FFFResult PlayerSession::SubmitExternalVideoFrame(const FFF3FPExternalVideoFrame& source) noexcept {
+    if (source.size < sizeof(FFF3FPExternalVideoFrame) || source.version != 1 ||
+        source.width == 0 || source.height == 0 || source.data[0] == nullptr ||
+        source.linesize[0] <= 0 || source.frameIndex < 0 || source.totalFrames < 0 ||
+        source.colorRange > 2) return FFFResult::InvalidArgument;
+
+    const auto pixelFormat = ExternalPixelFormat(source.format);
+    if (pixelFormat == AV_PIX_FMT_NONE) return FFFResult::NotSupported;
+    const auto* descriptor = av_pix_fmt_desc_get(pixelFormat);
+    if (descriptor == nullptr) return FFFResult::NotSupported;
+    const auto planeCount = av_pix_fmt_count_planes(pixelFormat);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        if (source.data[plane] == nullptr || source.linesize[plane] <= 0)
+            return FFFResult::InvalidArgument;
+    }
+
+    AVFrame frame{};
+    frame.width = static_cast<int>(source.width);
+    frame.height = static_cast<int>(source.height);
+    frame.format = pixelFormat;
+    frame.pts = source.frameIndex;
+    frame.best_effort_timestamp = source.frameIndex;
+    frame.duration = 1;
+    frame.color_range = source.colorRange == 2 ? AVCOL_RANGE_JPEG :
+        (source.colorRange == 1 ? AVCOL_RANGE_MPEG : AVCOL_RANGE_UNSPECIFIED);
+    frame.color_primaries = static_cast<AVColorPrimaries>(source.colorPrimaries);
+    frame.color_trc = static_cast<AVColorTransferCharacteristic>(source.colorTransfer);
+    frame.colorspace = static_cast<AVColorSpace>(source.colorMatrix);
+    frame.chroma_location = static_cast<AVChromaLocation>(source.chromaLocation);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        frame.data[plane] = static_cast<std::uint8_t*>(const_cast<void*>(source.data[plane]));
+        frame.linesize[plane] = source.linesize[plane];
+    }
+
+    const auto result = videoRenderer_.Render(&frame);
+    if (result != FFFResult::Success) {
+        if (result == FFFResult::DeviceFailure) videoRenderer_.RequestRecoveryIfDeviceLost();
+        return result;
+    }
+
+    FFF3FPSnapshot external{};
+    {
+        std::lock_guard lock(snapshotMutex_);
+        external = publishedSnapshot_;
+        external.size = sizeof(external);
+        external.version = 8;
+        external.state = FFF3FPState::Paused;
+        external.position100ns = source.duration100ns > 0 ? source.frameIndex * source.duration100ns : 0;
+        external.duration100ns = source.duration100ns > 0 ? source.totalFrames * source.duration100ns : 0;
+        external.frameIndex = source.frameIndex;
+        external.framePts = source.frameIndex;
+        external.frameTimeBaseNumerator = source.duration100ns > 0 ? static_cast<std::int32_t>(source.duration100ns) : 1;
+        external.frameTimeBaseDenominator = static_cast<std::int32_t>(TicksPerSecond);
+        external.videoWidth = source.width;
+        external.videoHeight = source.height;
+        external.decodedVideoFrames++;
+        external.actualColorMode = videoRenderer_.ActualColorMode();
+        external.sourcePeakNits = static_cast<std::uint32_t>(std::lround(videoRenderer_.SourcePeakNits()));
+        publishedSnapshot_ = external;
+    }
+    return FFFResult::Success;
+}
