+AVPixelFormat ExternalPixelFormat(const FFF3FPExternalPixelFormat format) noexcept {
+    switch (format) {
+    case FFF3FPExternalPixelFormat::Gray8: return AV_PIX_FMT_GRAY8;
+    case FFF3FPExternalPixelFormat::Gray16: return AV_PIX_FMT_GRAY16LE;
+    case FFF3FPExternalPixelFormat::Yuv420P8: return AV_PIX_FMT_YUV420P;
+    case FFF3FPExternalPixelFormat::Yuv420P10: return AV_PIX_FMT_YUV420P10LE;
+    case FFF3FPExternalPixelFormat::Yuv420P12: return AV_PIX_FMT_YUV420P12LE;
+    case FFF3FPExternalPixelFormat::Yuv420P16: return AV_PIX_FMT_YUV420P16LE;
+    case FFF3FPExternalPixelFormat::Yuv422P8: return AV_PIX_FMT_YUV422P;
+    case FFF3FPExternalPixelFormat::Yuv422P10: return AV_PIX_FMT_YUV422P10LE;
+    case FFF3FPExternalPixelFormat::Yuv422P12: return AV_PIX_FMT_YUV422P12LE;
+    case FFF3FPExternalPixelFormat::Yuv422P16: return AV_PIX_FMT_YUV422P16LE;
+    case FFF3FPExternalPixelFormat::Yuv444P8: return AV_PIX_FMT_YUV444P;
+    case FFF3FPExternalPixelFormat::Yuv444P10: return AV_PIX_FMT_YUV444P10LE;
+    case FFF3FPExternalPixelFormat::Yuv444P12: return AV_PIX_FMT_YUV444P12LE;
+    case FFF3FPExternalPixelFormat::Yuv444P16: return AV_PIX_FMT_YUV444P16LE;
+    case FFF3FPExternalPixelFormat::GbrP8: return AV_PIX_FMT_GBRP;
+    case FFF3FPExternalPixelFormat::GbrP10: return AV_PIX_FMT_GBRP10LE;
+    case FFF3FPExternalPixelFormat::GbrP12: return AV_PIX_FMT_GBRP12LE;
+    case FFF3FPExternalPixelFormat::GbrP16: return AV_PIX_FMT_GBRP16LE;
+    }
+    return AV_PIX_FMT_NONE;
+}
