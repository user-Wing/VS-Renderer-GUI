+FFFResult PlayerSession::QueueSoftwareVideoDecode(AVPacket* packet) noexcept {
+    auto* retained = packet != nullptr ? av_packet_clone(packet) : nullptr;
+    if (packet != nullptr && retained == nullptr) {
+        Fail(FFFResult::NativeFailure, "Could not retain the software video packet.", "decode");
+        return FFFResult::NativeFailure;
+    }
+    try {
+        std::lock_guard lock(softwareVideoMutex_);
+        if (!softwareVideoWorker_.joinable())
+            softwareVideoWorker_ = std::thread(&PlayerSession::SoftwareVideoDecodeWorker, this);
+        softwareVideoPacket_ = retained;
+        softwareVideoBusy_ = true;
+        if (packet == nullptr) softwareVideoDraining_ = true;
+    } catch (...) {
+        av_packet_free(&retained);
+        Fail(FFFResult::NativeFailure, "Could not start the software video worker.", "decode");
+        return FFFResult::NativeFailure;
+    }
+    softwareVideoCondition_.notify_one();
+    return FFFResult::Success;
+}
+
+int PlayerSession::ReceiveSoftwareVideoFrames(AVFrame* frame) noexcept {
+    for (;;) {
+        int result;
+        {
+            std::lock_guard lock(softwareVideoCodecMutex_);
+            result = avcodec_receive_frame(videoDecoder_, frame);
+        }
+        if (result < 0) return result;
+        std::unique_lock lock(softwareVideoMutex_);
+        softwareVideoCondition_.wait(lock, [this] {
+            return softwareVideoOutput_ == nullptr || softwareVideoDiscard_;
+        });
+        if (!softwareVideoDiscard_) {
+            softwareVideoOutput_ = av_frame_clone(frame);
+            if (softwareVideoOutput_ == nullptr) { av_frame_unref(frame); return AVERROR(ENOMEM); }
+        }
+        av_frame_unref(frame);
+        commandCondition_.notify_one();
+    }
+}
+
+void PlayerSession::SoftwareVideoDecodeWorker() noexcept {
+    auto* frame = av_frame_alloc();
+    for (;;) {
+        AVPacket* packet;
+        {
+            std::unique_lock lock(softwareVideoMutex_);
+            softwareVideoCondition_.wait(lock, [this] { return softwareVideoStopping_ || softwareVideoBusy_; });
+            if (softwareVideoStopping_) break;
+            packet = softwareVideoPacket_;
+            softwareVideoPacket_ = nullptr;
+        }
+        const auto sendPacket = [&] {
+            std::lock_guard lock(softwareVideoCodecMutex_);
+            return frame != nullptr ? avcodec_send_packet(videoDecoder_, packet) : AVERROR(ENOMEM);
+        };
+        auto result = sendPacket();
+        if (result == AVERROR(EAGAIN)) {
+            result = ReceiveSoftwareVideoFrames(frame);
+            if (result == AVERROR(EAGAIN)) result = sendPacket();
+        }
+        if (result >= 0 || result == AVERROR_EOF) result = ReceiveSoftwareVideoFrames(frame);
+        av_packet_free(&packet);
+        {
+            std::lock_guard lock(softwareVideoMutex_);
+            softwareVideoResult_ = result;
+            softwareVideoBusy_ = false;
+        }
+        softwareVideoCondition_.notify_all();
+        commandCondition_.notify_one();
+    }
+    av_frame_free(&frame);
+}
+
+bool PlayerSession::SoftwareVideoDecodePending() noexcept {
+    std::lock_guard lock(softwareVideoMutex_);
+    return softwareVideoBusy_ || softwareVideoOutput_ != nullptr;
+}
+
+bool PlayerSession::CollectSoftwareVideoFrame() noexcept {
+    AVFrame* frame = nullptr;
+    int result;
+    {
+        std::lock_guard lock(softwareVideoMutex_);
+        const auto limit = VideoFrameQueueLimit(videoFrameQueue_);
+        if (videoFrameQueue_.size() < std::max<std::size_t>(1, limit - 1)) {
+            frame = softwareVideoOutput_;
+            softwareVideoOutput_ = nullptr;
+        }
+        result = softwareVideoResult_;
+        softwareVideoResult_ = 0;
+    }
+    if (frame != nullptr) {
+        softwareVideoCondition_.notify_one();
+        NormalizeVideoFrameTimestamp(frame);
+        QueueVideoFrame(frame);
+        av_frame_free(&frame);
+    }
+    if (result < 0 && result != AVERROR(EAGAIN) && result != AVERROR_EOF) {
+        Fail(FFFResult::FfmpegFailure, "Software video decoder failed: " + FfmpegError(result), "decode");
+        return false;
+    }
+    return true;
+}
+
+void PlayerSession::ResetSoftwareVideoDecode() noexcept {
+    std::unique_lock lock(softwareVideoMutex_);
+    softwareVideoDiscard_ = true;
+    softwareVideoCondition_.notify_all();
+    softwareVideoCondition_.wait(lock, [this] { return !softwareVideoBusy_; });
+    av_frame_free(&softwareVideoOutput_);
+    softwareVideoResult_ = 0;
+    softwareVideoDiscard_ = false;
+    softwareVideoDraining_ = false;
+    videoTailClock_ = false;
+}
+
+void PlayerSession::StopSoftwareVideoDecode() noexcept {
+    ResetSoftwareVideoDecode();
+    {
+        std::lock_guard lock(softwareVideoMutex_);
+        softwareVideoStopping_ = true;
+    }
+    softwareVideoCondition_.notify_one();
+    if (softwareVideoWorker_.joinable()) softwareVideoWorker_.join();
+    softwareVideoStopping_ = false;
+}
