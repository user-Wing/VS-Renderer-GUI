+void PlayerSession::RetainSourcePixelFrame(const AVFrame* frame, const std::uint32_t rotation) noexcept {
+    std::lock_guard lock(sourcePixelMutex_);
+    if (!sourcePixelFrame_) sourcePixelFrame_ = av_frame_alloc();
+    if (!sourcePixelFrame_) return;
+    av_frame_unref(sourcePixelFrame_);
+    av_frame_ref(sourcePixelFrame_, frame);
+    sourcePixelRotation_ = rotation;
+}
+
+FFFResult PlayerSession::ReadSourcePixel(VsrSourcePixelProbe& probe) noexcept {
+    if (probe.size != sizeof(probe) || probe.version != 1 || probe.coordinates > 1)
+        return FFFResult::InvalidArgument;
+    FFF3FPRenderTargetInfo target{}; target.size = sizeof(target); target.version = 20;
+    if (GetRenderTargetInfo(target) != FFFResult::Success || !target.destWidth || !target.destHeight)
+        return FFFResult::InvalidState;
+    std::lock_guard lock(sourcePixelMutex_);
+    if (!sourcePixelFrame_ || !sourcePixelFrame_->buf[0]) return FFFResult::InvalidState;
+    if (IsHardwareFrame(sourcePixelFrame_)) {
+        auto* cpu = av_frame_alloc();
+        if (!cpu) return FFFResult::NativeFailure;
+        if (av_hwframe_transfer_data(cpu, sourcePixelFrame_, 0) < 0) {
+            av_frame_free(&cpu); return FFFResult::FfmpegFailure;
+        }
+        av_frame_copy_props(cpu, sourcePixelFrame_);
+        av_frame_free(&sourcePixelFrame_); sourcePixelFrame_ = cpu;
+    }
+    const auto* frame = sourcePixelFrame_;
+    const auto* descriptor = av_pix_fmt_desc_get(static_cast<AVPixelFormat>(frame->format));
+    if (!descriptor || (descriptor->flags & (AV_PIX_FMT_FLAG_FLOAT | AV_PIX_FMT_FLAG_BITSTREAM | AV_PIX_FMT_FLAG_PAL)))
+        return FFFResult::NotSupported;
+    probe.width = frame->width; probe.height = frame->height;
+    probe.family = descriptor->flags & AV_PIX_FMT_FLAG_RGB ? 2 : descriptor->nb_components < 3 ? 3 : 1;
+    probe.bitDepth = descriptor->comp[0].depth;
+    probe.chromaShiftX = descriptor->log2_chroma_w; probe.chromaShiftY = descriptor->log2_chroma_h;
+    if (probe.coordinates == 1) {
+        const double u = (probe.x - target.destX + .5) / target.destWidth;
+        const double v = (probe.y - target.destY + .5) / target.destHeight;
+        if (u < 0 || u >= 1 || v < 0 || v >= 1) return FFFResult::InvalidArgument;
+        double x = u, y = v;
+        switch (sourcePixelRotation_ & 3u) {
+        case 1: x = v; y = 1 - u; break;
+        case 2: x = 1 - u; y = 1 - v; break;
+        case 3: x = 1 - v; y = u; break;
+        }
+        probe.x = static_cast<int>(x * frame->width); probe.y = static_cast<int>(y * frame->height);
+    }
+    if (probe.x < 0 || probe.y < 0 || probe.x >= frame->width || probe.y >= frame->height)
+        return FFFResult::InvalidArgument;
+    double u = (probe.x + .5) / frame->width, v = (probe.y + .5) / frame->height;
+    switch (sourcePixelRotation_ & 3u) {
+    case 1: { const auto old = u; u = 1 - v; v = old; break; }
+    case 2: u = 1 - u; v = 1 - v; break;
+    case 3: { const auto old = u; u = v; v = 1 - old; break; }
+    }
+    probe.surfaceX = static_cast<int>(std::floor(target.destX + u * target.destWidth));
+    probe.surfaceY = static_cast<int>(std::floor(target.destY + v * target.destHeight));
+    for (int c = 0; c < std::min(3, static_cast<int>(descriptor->nb_components)); ++c) {
+        const auto& component = descriptor->comp[c];
+        if (component.depth > 16 || component.shift + component.depth > 16) return FFFResult::NotSupported;
+        const bool chroma = probe.family == 1 && c > 0;
+        const auto x = probe.x >> (chroma ? descriptor->log2_chroma_w : 0);
+        const auto y = probe.y >> (chroma ? descriptor->log2_chroma_h : 0);
+        const auto* data = frame->data[component.plane] + static_cast<std::ptrdiff_t>(y) * frame->linesize[component.plane] + x * component.step + component.offset;
+        unsigned value = data[0];
+        if (component.shift + component.depth > 8)
+            value = descriptor->flags & AV_PIX_FMT_FLAG_BE ? (data[0] << 8) | data[1] : data[0] | (data[1] << 8);
+        probe.values[c] = (value >> component.shift) & ((1u << component.depth) - 1);
+    }
+    return FFFResult::Success;
+}
