@@ -0,0 +1,46 @@
+//! Private, user-only Windows named pipe owned by the launching VSP instance.
+//! Closing VSP disconnects the pipe, leaving the editor's unsaved documents intact.
+use photocraft_ui_egui::{OsEvent, OsEventsFn};
+use std::io::{BufRead, BufReader};
+
+pub fn connect(name: String, ctx: &egui::Context) -> OsEventsFn {
+    let (tx, rx) = std::sync::mpsc::channel();
+    let ctx = ctx.clone();
+    std::thread::spawn(move || {
+        let file = match std::fs::OpenOptions::new().read(true).write(true).open(&name) {
+            Ok(file) => file,
+            Err(e) => {
+                log::error!("VSP pipe {name}: {e}");
+                return;
+            }
+        };
+        for line in BufReader::new(file).lines() {
+            let Ok(line) = line else { break };
+            if let Some(path) = open_path(&line) {
+                if tx.send(OsEvent::Open(vec![path])).is_err() {
+                    break;
+                }
+                ctx.request_repaint();
+            }
+        }
+    });
+    Box::new(move || rx.try_iter().collect())
+}
+
+fn open_path(line: &str) -> Option<String> {
+    let value: serde_json::Value = serde_json::from_str(line).ok()?;
+    let path = value.get("open")?.as_str()?;
+    (std::path::Path::new(path).is_absolute() && !path.contains('\0')).then(|| path.to_string())
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn accepts_unicode_absolute_paths_only() {
+        let path = std::env::temp_dir().join("中文 folder/image.png").to_string_lossy().into_owned();
+        assert_eq!(super::open_path(&serde_json::json!({"open": path}).to_string()), Some(path));
+        for line in ["{}", "{", r#"{"open":"../x"}"#, r#"{"open":3}"#] {
+            assert!(super::open_path(line).is_none());
+        }
+    }
+}
