index 000000000..475ded3b3
--- /dev/null
+++ b/crates/io/src/vsp_image.rs
@@ -0,0 +1,96 @@
+//! Band-streamed VSP image exchange. No full-size encoded or decoded intermediate buffer.
+use std::io::Read;
+use std::sync::Arc;
+
+use photocraft_color::{ColorMode, PixelFormat, SampleType};
+use photocraft_doc::{Document, Layer, LayerContent};
+use photocraft_geom::{Rect, Size};
+use photocraft_raster::{Interrupt, Surface};
+
+use crate::{ImportResult, IoError};
+
+pub fn import(path: &str, ctl: &Interrupt) -> Result<ImportResult, IoError> {
+    let fail = |e: std::io::Error| IoError::Unsupported(e.to_string());
+    let manifest_file = std::fs::File::open(path).map_err(fail)?;
+    let mut bytes = Vec::new();
+    manifest_file.take(65537).read_to_end(&mut bytes).map_err(fail)?;
+    if bytes.len() > 65536 {
+        return Err(IoError::Unsupported("VSP manifest too large".into()));
+    }
+    let manifest: serde_json::Value = serde_json::from_slice(&bytes).map_err(|e| IoError::Unsupported(e.to_string()))?;
+    let number = |key: &str| {
+        manifest.get(key).and_then(|v| v.as_u64()).and_then(|v| u32::try_from(v).ok()).ok_or_else(|| IoError::Unsupported(format!("Invalid VSP {key}")))
+    };
+    let (w, h, bits) = (number("width")?, number("height")?, number("bits")?);
+    if number("version")? != 1 || w == 0 || h == 0 || w > 300000 || h > 300000 {
+        return Err(IoError::Unsupported("Invalid VSP dimensions/version".into()));
+    }
+    let depth = match bits {
+        8 => SampleType::U8,
+        16 => SampleType::U16,
+        32 => SampleType::F32,
+        _ => return Err(IoError::Unsupported("Invalid VSP depth".into())),
+    };
+    let row = u64::from(w) * u64::from(bits / 8) * 4;
+    let total = row * u64::from(h);
+    if total > 16 << 30 {
+        return Err(IoError::Unsupported("VSP image exceeds 16 GiB".into()));
+    }
+    let mut file = std::fs::File::open(format!("{path}.raw")).map_err(fail)?;
+    if file.metadata().map_err(fail)?.len() != total {
+        return Err(IoError::Unsupported("Truncated VSP pixels".into()));
+    }
+    let rows = ((32 << 20) / row).max(1).min(u64::from(h)) as u32;
+    let mut band = vec![0; (row * u64::from(rows)) as usize];
+    let mut surface = Surface::new(PixelFormat::new(ColorMode::Rgb, depth, true));
+    for y in (0..h).step_by(rows as usize) {
+        ctl.check().map_err(|_| IoError::Cancelled)?;
+        let n = rows.min(h - y);
+        let data = band.get_mut(..(row * u64::from(n)) as usize).ok_or_else(|| IoError::Unsupported("Invalid VSP band".into()))?;
+        file.read_exact(data).map_err(fail)?;
+        surface.write_interleaved(Rect::new(0, y as i32, w as i32, (y + n) as i32), data);
+        ctl.progress((y + n) as f32 / h as f32);
+    }
+    let name = manifest.get("name").and_then(|v| v.as_str()).unwrap_or("VSP image");
+    let mut document = Document::new(name, Size::new(w, h), ColorMode::Rgb, depth);
+    if manifest.get("icc").and_then(|v| v.as_bool()) == Some(true) {
+        let profile = std::fs::File::open(format!("{path}.icc")).map_err(fail)?;
+        if profile.metadata().map_err(fail)?.len() > 16 << 20 {
+            return Err(IoError::Unsupported("VSP ICC too large".into()));
+        }
+        let mut bytes = Vec::new();
+        profile.take(16 << 20).read_to_end(&mut bytes).map_err(fail)?;
+        document.icc_profile = Some(Arc::new(bytes));
+    }
+    document.layers.push(Layer::new("Background", LayerContent::Raster(surface)));
+    if manifest.get("temporary").and_then(|v| v.as_bool()) == Some(true) {
+        drop(file);
+        let _ = std::fs::remove_file(format!("{path}.raw"));
+        let _ = std::fs::remove_file(format!("{path}.icc"));
+        let _ = std::fs::remove_file(path);
+    }
+    Ok(ImportResult { document, warnings: Vec::new(), preview_only: false, source_read_only: false })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn band_import_preserves_all_depths_and_rejects_truncation() {
+        for bits in [8, 16, 32] {
+            let path = std::env::temp_dir().join(format!("vsp-band-{}-{bits}.vspimage", std::process::id()));
+            let path = path.to_string_lossy();
+            std::fs::write(path.as_ref(), format!(r#"{{"version":1,"width":32769,"height":1,"bits":{bits},"name":"wide","icc":false}}"#)).unwrap();
+            let pixels = vec![0x3e; 32769 * 4 * (bits / 8) as usize];
+            std::fs::write(format!("{path}.raw"), &pixels).unwrap();
+            let r = import(&path, &Interrupt::NONE).unwrap();
+            assert_eq!(r.document.size, Size::new(32769, 1));
+            let surface = r.document.layers[0].surface().unwrap();
+            assert_eq!(surface.to_interleaved(Rect::new(0, 0, 32769, 1)), pixels);
+            std::fs::write(format!("{path}.raw"), [1]).unwrap();
+            assert!(import(&path, &Interrupt::NONE).is_err());
+            std::fs::remove_file(path.as_ref()).unwrap();
+            std::fs::remove_file(format!("{path}.raw")).unwrap();
+        }
+    }
+}
