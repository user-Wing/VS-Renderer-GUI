+// Opt-in diagnostics. Timestamp results are polled without flushing or waiting.
+struct PlaybackProfiler {
+    struct Sample {
+        ComPtr<ID3D11Query> disjoint, start, end;
+        bool pending = false;
+        std::uint64_t generation = 0;
+        LARGE_INTEGER cpuStart{}, cpuEnd{};
+    } samples[2][8];
+    unsigned counters[2]{};
+    LARGE_INTEGER frequency{};
+    PlaybackProfiler() { QueryPerformanceFrequency(&frequency); }
+    Sample* Begin(ID3D11Device* device, ID3D11DeviceContext* context,
+        unsigned stage, std::uint64_t generation) {
+        for (auto& sample : samples[stage]) {
+            if (!sample.pending) continue;
+            D3D11_QUERY_DATA_TIMESTAMP_DISJOINT timing{};
+            UINT64 start = 0, end = 0;
+            if (context->GetData(sample.disjoint.Get(), &timing, sizeof(timing), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK ||
+                context->GetData(sample.start.Get(), &start, sizeof(start), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK ||
+                context->GetData(sample.end.Get(), &end, sizeof(end), D3D11_ASYNC_GETDATA_DONOTFLUSH) != S_OK) continue;
+            sample.pending = false;
+            if (timing.Disjoint || !timing.Frequency) continue;
+            char line[256]{};
+            std::snprintf(line, sizeof(line), "GPU_PROFILE,%s,%llu,%.6f,%.6f,%lld,%lld",
+                stage == 0 ? "upload" : "compose", sample.generation,
+                (sample.cpuEnd.QuadPart - sample.cpuStart.QuadPart) * 1000.0 / frequency.QuadPart,
+                (end - start) * 1000.0 / timing.Frequency, sample.cpuStart.QuadPart, sample.cpuEnd.QuadPart);
+            FFF3FP_KernelLogImpl(line);
+        }
+        if (++counters[stage] % 16) return nullptr;
+        for (auto& sample : samples[stage]) {
+            if (sample.pending) continue;
+            if (!sample.disjoint) {
+                D3D11_QUERY_DESC desc{D3D11_QUERY_TIMESTAMP_DISJOINT, 0};
+                if (FAILED(device->CreateQuery(&desc, &sample.disjoint))) return nullptr;
+                desc.Query = D3D11_QUERY_TIMESTAMP;
+                if (FAILED(device->CreateQuery(&desc, &sample.start)) ||
+                    FAILED(device->CreateQuery(&desc, &sample.end))) return nullptr;
+            }
+            sample.generation = generation;
+            QueryPerformanceCounter(&sample.cpuStart);
+            context->Begin(sample.disjoint.Get()); context->End(sample.start.Get());
+            return &sample;
+        }
+        return nullptr;
+    }
+    struct Scope {
+        ID3D11DeviceContext* context;
+        Sample* sample;
+        Scope(PlaybackProfiler* profiler, ID3D11Device* device, ID3D11DeviceContext* ctx,
+            unsigned stage, std::uint64_t generation) : context(ctx),
+            sample(profiler ? profiler->Begin(device, ctx, stage, generation) : nullptr) {}
+        ~Scope() { Finish(); }
+        void Finish() {
+            if (!sample) return;
+            context->End(sample->end.Get()); context->End(sample->disjoint.Get());
+            QueryPerformanceCounter(&sample->cpuEnd); sample->pending = true;
+            sample = nullptr;
+        }
+    };
+};
