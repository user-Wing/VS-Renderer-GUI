+struct SoftwareCpuLayout {
+    std::vector<DWORD_PTR> workers;
+    DWORD_PTR host=0;
+};
+SoftwareCpuLayout SoftwareDecoderCpuLayout(unsigned workers) {
+    wchar_t enabled[8]{};
+    const auto mode=GetEnvironmentVariableW(L"VSR_SW_CCD",enabled,8)?enabled[0]:L'2';
+    if(workers!=8 || (mode!=L'1' && mode!=L'2') || GetActiveProcessorGroupCount()!=1)return {};
+    DWORD_PTR allowed=0,system=0;GetProcessAffinityMask(GetCurrentProcess(),&allowed,&system);
+    DWORD bytes=0;GetLogicalProcessorInformation(nullptr,&bytes);
+    std::vector<SYSTEM_LOGICAL_PROCESSOR_INFORMATION> topology(bytes/sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION));
+    if(topology.empty() || !GetLogicalProcessorInformation(topology.data(),&bytes))return {};
+    std::vector<DWORD_PTR> cores,caches;
+    for(const auto &entry:topology){
+        if(entry.Relationship==RelationProcessorCore && (entry.ProcessorMask&allowed))cores.push_back(entry.ProcessorMask&allowed);
+        if(entry.Relationship==RelationCache && entry.Cache.Level==3)caches.push_back(entry.ProcessorMask&allowed);
+    }
+    std::sort(cores.begin(),cores.end());std::sort(caches.begin(),caches.end());
+    if(caches.size()!=2){
+        DWORD size=0;GetLogicalProcessorInformationEx(RelationProcessorCore,nullptr,&size);
+        std::vector<unsigned char> data(size);
+        if(!size || !GetLogicalProcessorInformationEx(RelationProcessorCore,reinterpret_cast<PSYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX>(data.data()),&size))return {};
+        BYTE highest=0,lowest=255;
+        for(DWORD offset=0;offset<size;){const auto *entry=reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*>(data.data()+offset);highest=(std::max)(highest,entry->Processor.EfficiencyClass);lowest=(std::min)(lowest,entry->Processor.EfficiencyClass);offset+=entry->Size;}
+        if(highest==lowest)return {};
+        SoftwareCpuLayout layout;layout.host=allowed;
+        for(DWORD offset=0;offset<size;){
+            const auto *entry=reinterpret_cast<const SYSTEM_LOGICAL_PROCESSOR_INFORMATION_EX*>(data.data()+offset);
+            const auto mask=entry->Processor.GroupMask[0].Mask&allowed;
+            if(entry->Processor.EfficiencyClass==highest && mask && layout.workers.size()<workers){layout.workers.push_back(mask);layout.host&=~mask;}
+            offset+=entry->Size;
+        }
+        return layout.workers.size()==workers && layout.host?layout:SoftwareCpuLayout{};
+    }
+    SoftwareCpuLayout layout;layout.host=allowed;
+    for(const auto cache:caches){
+        unsigned count=0;
+        for(const auto core:cores)if((core&cache) && count<workers/2){layout.workers.push_back(core);layout.host&=~core;++count;}
+        if(count!=workers/2)return {};
+    }
+    return layout.host?layout:SoftwareCpuLayout{};
+}
