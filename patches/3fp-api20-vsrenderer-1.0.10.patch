+void PlayerSession::SoftwareVideoDecodeWorker(AVCodecContext* decoder) noexcept {
+    if(softwareDecoderAffinity_)SetThreadAffinityMask(GetCurrentThread(),softwareDecoderAffinity_);
+    auto* frame = av_frame_alloc();
+    const auto receive = [&] {
+        int result;
+        for (;;) {
+            {
+                std::lock_guard lock(softwareVideoCodecMutex_);
+                result = avcodec_receive_frame(decoder, frame);
+            }
+            if (result < 0) return result;
+            std::unique_lock lock(softwareVideoMutex_);
+            softwareVideoCondition_.wait(lock, [this] { return softwareVideoOutputs_.size()<softwareVideoOutputLimit_ || softwareVideoStopping_; });
+            if (!softwareVideoStopping_) {
+                auto *retained=av_frame_clone(frame);
+                if (!retained) { av_frame_unref(frame); return AVERROR(ENOMEM); }
+                softwareVideoOutputs_.push_back(retained);
+            }
+            av_frame_unref(frame);
+            commandCondition_.notify_one();
+        }
+    };
+    for (;;) {
+        AVPacket* packet;
+        {
+            std::unique_lock lock(softwareVideoMutex_);
+            softwareVideoCondition_.wait(lock, [this] { return softwareVideoStopping_ || !softwareVideoPackets_.empty(); });
+            if (softwareVideoStopping_) break;
+            packet = softwareVideoPackets_.front();softwareVideoPackets_.pop_front();softwareVideoBusy_ = true;
+        }
+        const auto send = [&] {
+            std::lock_guard lock(softwareVideoCodecMutex_);
+            return frame ? avcodec_send_packet(decoder, packet) : AVERROR(ENOMEM);
+        };
+        auto result = send();
+        if (result == AVERROR(EAGAIN)) {
+            result = receive();
+            if (result == AVERROR(EAGAIN)) result = send();
+        }
+        if (result >= 0 || result == AVERROR_EOF) result = receive();
+        // Navigation loops can cross a damaged/discontinuous access unit. Keep
+        // the disc VM alive and let the next independently decodable frame recover.
+        if (result == AVERROR_INVALIDDATA && disc_) {
+            std::lock_guard lock(softwareVideoCodecMutex_);
+            avcodec_flush_buffers(decoder);result = 0;
+        }
+        if(result<0 && result!=AVERROR(EAGAIN) && result!=AVERROR_EOF && GetEnvironmentVariableW(L"VSR_SW_REALTIME_TRACE",nullptr,0))std::fprintf(stderr,"DECODE rc=%d pts=%lld key=%d size=%d refs=%u\n",result,packet?static_cast<long long>(packet->pts):-1,packet?packet->flags:0,packet?packet->size:0,unsigned(decoder->skip_frame==AVDISCARD_NONREF));
