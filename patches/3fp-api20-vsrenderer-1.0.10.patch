+    if(Thread32First(snapshot,&entry))do{if(entry.th32OwnerProcessID==GetCurrentProcessId())ids.push_back(entry.th32ThreadID);}while(Thread32Next(snapshot,&entry));
+    CloseHandle(snapshot);std::sort(ids.begin(),ids.end());return ids;
+}
