+    case FFF3FPExternalPixelFormat::Yuv422P12: return AV_PIX_FMT_YUV422P12LE;
+    case FFF3FPExternalPixelFormat::Yuv422P16: return AV_PIX_FMT_YUV422P16LE;
+    case FFF3FPExternalPixelFormat::Yuv444P8: return AV_PIX_FMT_YUV444P;
+    case FFF3FPExternalPixelFormat::Yuv444P10: return AV_PIX_FMT_YUV444P10LE;
+    case FFF3FPExternalPixelFormat::Yuv444P12: return AV_PIX_FMT_YUV444P12LE;
+    case FFF3FPExternalPixelFormat::Yuv444P16: return AV_PIX_FMT_YUV444P16LE;
+    case FFF3FPExternalPixelFormat::GbrP8: return AV_PIX_FMT_GBRP;
+    case FFF3FPExternalPixelFormat::GbrP10: return AV_PIX_FMT_GBRP10LE;
+    case FFF3FPExternalPixelFormat::GbrP12: return AV_PIX_FMT_GBRP12LE;
+    case FFF3FPExternalPixelFormat::GbrP16: return AV_PIX_FMT_GBRP16LE;
+    }
+    return AV_PIX_FMT_NONE;
+}
+
+FFFResult PlayerSession::SetScalingAlgorithms(const FFF3FPScalingAlgorithm upscale,
+    const FFF3FPScalingAlgorithm downscale) noexcept {
+    const auto result = videoRenderer_.SetScalingAlgorithms(upscale, downscale);
+    if (result != FFFResult::Success) return result;
+    const auto redrawResult = videoRenderer_.Redraw();
+    return redrawResult == FFFResult::InvalidState ? FFFResult::Success : redrawResult;
+}
+
+FFFResult PlayerSession::SetExternalOutputFormat(const char* format) noexcept {
+    const auto value = !format || !*format ? AV_PIX_FMT_NONE : av_get_pix_fmt(format);
+    if (format && *format && (value == AV_PIX_FMT_NONE || !sws_isSupportedOutput(value))) return FFFResult::NotSupported;
+    externalOutputFormat_.store(static_cast<int>(value));
+    return FFFResult::Success;
+}
+
+FFFResult PlayerSession::SubmitExternalVideoFrame(const FFF3FPExternalVideoFrame& source) noexcept {
+    if (source.size < sizeof(FFF3FPExternalVideoFrame) || source.version != 1 ||
+        source.width == 0 || source.height == 0 || source.data[0] == nullptr ||
+        source.linesize[0] <= 0 || source.frameIndex < 0 || source.totalFrames < 0 ||
+        source.colorRange > 2) return FFFResult::InvalidArgument;
+
+    const auto pixelFormat = ExternalPixelFormat(source.format);
+    if (pixelFormat == AV_PIX_FMT_NONE) return FFFResult::NotSupported;
+    const auto* descriptor = av_pix_fmt_desc_get(pixelFormat);
+    if (descriptor == nullptr) return FFFResult::NotSupported;
+    const auto planeCount = av_pix_fmt_count_planes(pixelFormat);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        if (source.data[plane] == nullptr || source.linesize[plane] <= 0)
+            return FFFResult::InvalidArgument;
+    }
+
+    AVFrame frame{};
+    frame.width = static_cast<int>(source.width);
+    frame.height = static_cast<int>(source.height);
+    frame.format = pixelFormat;
+    frame.pts = source.frameIndex;
+    frame.best_effort_timestamp = source.frameIndex;
+    frame.duration = 1;
+    frame.color_range = source.colorRange == 2 ? AVCOL_RANGE_JPEG :
+        (source.colorRange == 1 ? AVCOL_RANGE_MPEG : AVCOL_RANGE_UNSPECIFIED);
+    frame.color_primaries = static_cast<AVColorPrimaries>(source.colorPrimaries);
+    frame.color_trc = static_cast<AVColorTransferCharacteristic>(source.colorTransfer);
+    frame.colorspace = static_cast<AVColorSpace>(source.colorMatrix);
+    frame.chroma_location = static_cast<AVChromaLocation>(source.chromaLocation);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        frame.data[plane] = static_cast<std::uint8_t*>(const_cast<void*>(source.data[plane]));
+        frame.linesize[plane] = source.linesize[plane];
+    }
+
+    AVFrame* owned=av_frame_alloc();
+    if(!owned) return FFFResult::NativeFailure;
+    owned->format=frame.format;owned->width=frame.width;owned->height=frame.height;
+    av_frame_copy_props(owned,&frame);
+    if(av_frame_get_buffer(owned,32)<0 || av_frame_copy(owned,&frame)<0){av_frame_free(&owned);return FFFResult::NativeFailure;}
+    AVFrame* converted = nullptr;
+    AVFrame* submitted = owned;
+    const auto target = static_cast<AVPixelFormat>(externalOutputFormat_.load());
+    if (target != AV_PIX_FMT_NONE && target != pixelFormat) {
+        converted = av_frame_alloc();
+        if (!converted) { av_frame_free(&owned); return FFFResult::NativeFailure; }
+        converted->width = frame.width; converted->height = frame.height; converted->format = target;
+        av_frame_copy_props(converted, &frame);
+        auto* scale = sws_getContext(frame.width, frame.height, pixelFormat, frame.width, frame.height, target, SWS_BICUBIC | SWS_ACCURATE_RND, nullptr, nullptr, nullptr);
+        if (!scale || av_frame_get_buffer(converted, 32) < 0) { sws_freeContext(scale); av_frame_free(&converted); av_frame_free(&owned); return FFFResult::NativeFailure; }
+        const int space = frame.colorspace == AVCOL_SPC_BT2020_NCL ? SWS_CS_BT2020 : frame.colorspace == AVCOL_SPC_BT470BG || frame.colorspace == AVCOL_SPC_SMPTE170M ? SWS_CS_ITU601 : SWS_CS_ITU709;
+        const int range = frame.color_range == AVCOL_RANGE_JPEG;
+        const auto* coefficients = sws_getCoefficients(space);
+        sws_setColorspaceDetails(scale, coefficients, range, coefficients, range, 0, 1 << 16, 1 << 16);
+        sws_scale(scale, frame.data, frame.linesize, 0, frame.height, converted->data, converted->linesize);
+        sws_freeContext(scale); submitted = converted;
+    }
+    const auto result = videoRenderer_.Render(submitted, source.frameIndex, false, false, false, false, nullptr, nullptr, true);
+    av_frame_free(&converted);av_frame_free(&owned);
+    if (result != FFFResult::Success) {
+        if (result == FFFResult::DeviceFailure) videoRenderer_.RequestRecoveryIfDeviceLost();
+        return result;
+    }
+
+    state_.store(FFF3FPState::Paused);
+    FFF3FPSnapshot external{};
+    {
+        std::lock_guard lock(snapshotMutex_);
+        external = publishedSnapshot_;
+        external.size = sizeof(external);
+        external.version = 20;
+        external.state = FFF3FPState::Paused;
+        external.position100ns = source.duration100ns > 0 ? source.frameIndex * source.duration100ns : 0;
+        external.duration100ns = source.duration100ns > 0 ? source.totalFrames * source.duration100ns : 0;
+        external.frameIndex = source.frameIndex;
+        external.framePts = source.frameIndex;
+        external.frameTimeBaseNumerator = source.duration100ns > 0 ? static_cast<std::int32_t>(source.duration100ns) : 1;
+        external.frameTimeBaseDenominator = static_cast<std::int32_t>(TicksPerSecond);
+        external.videoWidth = source.width;
+        external.videoHeight = source.height;
+        external.decodedVideoFrames++;
+        external.actualColorMode = videoRenderer_.ActualColorMode();
+        external.sourcePeakNits = static_cast<std::uint32_t>(std::lround(videoRenderer_.SourcePeakNits()));
+        publishedSnapshot_ = external;
+    }
+    return FFFResult::Success;
+}
+
+FFFResult PlayerSession::SetPlaybackRate(const double rate) noexcept {
+    if (!std::isfinite(rate) || rate < 0.1 || rate > 16.0) return FFFResult::InvalidArgument;
+    Enqueue([this, rate] {
+        const auto position = state_.load() == FFF3FPState::Playing ? ClockPosition() : snapshot_.position100ns;
+        playbackRate_ = rate;
+        DoSeek(position);
+    });
+    return FFFResult::Success;
+}
+void PlayerSession::ResetTempo(const std::int64_t position) noexcept {
+    if (tempoGraph_) avfilter_graph_free(&tempoGraph_);
+    tempoInput_ = nullptr; tempoOutput_ = nullptr; tempoSamples_ = 0; tempoOrigin_ = position;
+}
+FFFResult PlayerSession::TempoAudio(AVFrame* frame, const std::int64_t position, const std::int64_t timestampResolution) noexcept {
+    audioRenderer_->TapAsr(frame,position);
+    const double rate = playbackRate_.load();
+    if (rate == 1.0 && !equalizerEnabled_ && waveVolume_ == 1) return audioRenderer_->Enqueue(frame, position, timestampResolution, false);
+    if (!tempoGraph_) {
+        if (!frame) return FFFResult::Success;
+        if(position!=AV_NOPTS_VALUE)tempoOrigin_=std::max(tempoOrigin_,position);
+        tempoGraph_ = avfilter_graph_alloc();
+        if (!tempoGraph_) return FFFResult::NativeFailure;
+        char layout[128]{};AVChannelLayout channels{};
+        if(frame->ch_layout.order==AV_CHANNEL_ORDER_UNSPEC)av_channel_layout_default(&channels,frame->ch_layout.nb_channels);
+        else av_channel_layout_copy(&channels,&frame->ch_layout);
+        av_channel_layout_describe(&channels,layout,sizeof(layout));av_channel_layout_uninit(&channels);
+        std::ostringstream args;
+        args << "time_base=1/" << frame->sample_rate << ":sample_rate=" << frame->sample_rate
+             << ":sample_fmt=" << av_get_sample_fmt_name(static_cast<AVSampleFormat>(frame->format)) << ":channel_layout=" << layout;
+        if (avfilter_graph_create_filter(&tempoInput_, avfilter_get_by_name("abuffer"), "input", args.str().c_str(), nullptr, tempoGraph_) < 0 ||
+            avfilter_graph_create_filter(&tempoOutput_, avfilter_get_by_name("abuffersink"), "output", nullptr, nullptr, tempoGraph_) < 0) return FFFResult::FfmpegFailure;
+        AVFilterContext* previous = tempoInput_;
+        double remainder = rate; int index = 0;
+        do {
+            const auto factor = std::clamp(remainder, 0.5, 2.0);
+            AVFilterContext* filter = nullptr;
+            const auto name = "tempo" + std::to_string(index++);
+            const auto factorText = std::to_string(factor);
+            if (avfilter_graph_create_filter(&filter, avfilter_get_by_name("atempo"), name.c_str(), factorText.c_str(), nullptr, tempoGraph_) < 0 ||
+                avfilter_link(previous, 0, filter, 0) < 0) return FFFResult::FfmpegFailure;
+            previous = filter; remainder /= factor;
+        } while (std::abs(remainder - 1.0) > 0.00001);
+        if (equalizerEnabled_) {
+            constexpr int frequencies[]{60,170,310,600,1000,3000,6000,12000,14000,16000};
+            for (int band=0;band<10;++band) {
+                if (frequencies[band]>=frame->sample_rate/2) continue;
+                AVFilterContext* filter=nullptr;
+                const auto name="eq"+std::to_string(band);
+                const auto options="f="+std::to_string(frequencies[band])+":t=o:w=1:g="+std::to_string(equalizerGains_[band]);
+                if(avfilter_graph_create_filter(&filter,avfilter_get_by_name("equalizer"),name.c_str(),options.c_str(),nullptr,tempoGraph_)<0 || avfilter_link(previous,0,filter,0)<0)return FFFResult::FfmpegFailure;
+                previous=filter;
+            }
+        }
+        if(waveVolume_!=1) {
+            AVFilterContext* filter=nullptr;const auto options=std::to_string(waveVolume_);
+            if(avfilter_graph_create_filter(&filter,avfilter_get_by_name("volume"),"wave",options.c_str(),nullptr,tempoGraph_)<0 || avfilter_link(previous,0,filter,0)<0)return FFFResult::FfmpegFailure;
+            previous=filter;
+        }
+        if (avfilter_link(previous, 0, tempoOutput_, 0) < 0 || avfilter_graph_config(tempoGraph_, nullptr) < 0) return FFFResult::FfmpegFailure;
+    }
+    AVFrame* input = frame ? av_frame_clone(frame) : nullptr;
+    if (frame && !input) return FFFResult::NativeFailure;
+    if (input) {
+        if(input->ch_layout.order==AV_CHANNEL_ORDER_UNSPEC){const int count=input->ch_layout.nb_channels;av_channel_layout_uninit(&input->ch_layout);av_channel_layout_default(&input->ch_layout,count);}
+        const auto skipped = position != AV_NOPTS_VALUE && position < tempoOrigin_
+            ? std::min<std::int64_t>(input->nb_samples, av_rescale_rnd(tempoOrigin_ - position, input->sample_rate, 10000000, AV_ROUND_UP)) : 0;
+        if (skipped >= input->nb_samples) { av_frame_free(&input); return FFFResult::Success; }
+        if (skipped) {
+            const auto format = static_cast<AVSampleFormat>(input->format);
+            const auto planar = av_sample_fmt_is_planar(format);
+            const auto planes = planar ? input->ch_layout.nb_channels : 1;
+            const auto offset = skipped * av_get_bytes_per_sample(format) * (planar ? 1 : input->ch_layout.nb_channels);
+            for (int plane = 0; plane < planes; ++plane) { input->extended_data[plane] += offset; if (plane < AV_NUM_DATA_POINTERS) input->data[plane] = input->extended_data[plane]; }
+            input->nb_samples -= static_cast<int>(skipped);
+        }
+        input->pts = position == AV_NOPTS_VALUE ? AV_NOPTS_VALUE : av_rescale_q(position - tempoOrigin_, AVRational{1, 10000000}, AVRational{1, frame->sample_rate}) + skipped;
+    }
+    const auto sent = av_buffersrc_add_frame_flags(tempoInput_, input, AV_BUFFERSRC_FLAG_KEEP_REF);
+    av_frame_free(&input);
+    if (sent < 0) return FFFResult::FfmpegFailure;
+    AVFrame* output = av_frame_alloc();
+    if (!output) return FFFResult::NativeFailure;
+    FFFResult result = FFFResult::Success;
+    while (av_buffersink_get_frame(tempoOutput_, output) >= 0) {
+        const auto outputPosition = tempoOrigin_ + av_rescale(tempoSamples_, 10000000, output->sample_rate);
+        result = audioRenderer_->Enqueue(output, outputPosition, 0, false);
+        tempoSamples_ += output->nb_samples;
+        av_frame_unref(output);
+        if (result != FFFResult::Success) break;
+    }
+    av_frame_free(&output); return result;
+}
+FFFResult PlayerSession::SetAudioEffects(const bool enabled,const float* gains,const float wave,const std::int64_t delay) noexcept {
+    if(!gains || !std::isfinite(wave) || wave<0 || wave>1)return FFFResult::InvalidArgument;
+    std::array<float,10> values{};for(int i=0;i<10;++i){if(!std::isfinite(gains[i]) || gains[i]<-12 || gains[i]>12)return FFFResult::InvalidArgument;values[i]=gains[i];}
+    Enqueue([this,enabled,values,wave,delay]{
+        const bool shifted=audioDelay100ns_!=delay;
+        const bool reuse=tempoGraph_ && equalizerEnabled_==enabled && waveVolume_==wave && !shifted;
+        equalizerEnabled_=enabled;waveVolume_=wave;audioDelay100ns_=delay;
+        for(int i=0;i<10;++i)equalizerGains_[i]=values[i];
+        if(reuse) {
+            bool updated=true;
+            for(int i=0;enabled && i<10;++i){const auto name="eq"+std::to_string(i);if(!avfilter_graph_get_filter(tempoGraph_,name.c_str()))continue;const auto gain=std::to_string(values[i]);if(avfilter_graph_send_command(tempoGraph_,name.c_str(),"gain",gain.c_str(),nullptr,0,0)<0)updated=false;}
+            if(updated)return;
+        }
+        if(shifted && format_)DoSeek(snapshot_.position100ns);
+        else ResetTempo(audioRenderer_?audioRenderer_->Position100ns():snapshot_.position100ns);
+    });return FFFResult::Success;
+}
