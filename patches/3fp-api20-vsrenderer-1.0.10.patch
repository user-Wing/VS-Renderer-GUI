diff --git a/FFF.Native/3FP/Render/VideoRenderer.cpp b/FFF.Native/3FP/Render/VideoRenderer.cpp
index 8887c06a613fecf605ebe65ec9813eac06fefde8..c425fcee70fb85254b45488d97f71e7679716ee0 100644
--- a/FFF.Native/3FP/Render/VideoRenderer.cpp
+++ b/FFF.Native/3FP/Render/VideoRenderer.cpp
@@ -1,4 +1,5 @@
 #include "pch.h"
+#include "3FP/Core/PlaybackScheduling.h"
 #include "3FP/Render/VideoRenderer.h"
 #include "3FP/Render/ShaderBytecode.h"
 #include "3FP/Render/SdrShaderBytecode.h"
@@ -492,7 +493,8 @@ cbuffer Settings : register(b0) {
     float COffset; float CScale; float Kr; float Kb;
     float2 ChromaOffset; float2 ImageMode;
     uint Projection360; float ViewYaw; float ViewPitch; float ViewFovY;
-    float ViewAspect; float ViewRotation; float3 ViewPadding;
+    float ViewAspect; float ViewRotation; float2 ViewPadding;
+    uint UpscaleAlgorithm; uint DownscaleAlgorithm; uint2 VsrPadding;
 };
 #ifdef FFF_SDR_LAYOUT
 // Compile-time specialization only: sampling and color formulas stay identical.
@@ -701,6 +703,31 @@ float Lanczos3Weight(float value) {
 float4 LoadClamped(Texture2D<float4> sourceTexture,int2 coordinate,uint2 dimensions) {
     return sourceTexture.Load(int3(clamp(coordinate,int2(0,0),int2(dimensions)-1),0));
 }
+Texture1D<float> JincWeights : register(t5);
+float Jinc2Weight(float value) { value=abs(value);return value>=2.0?0.0:JincWeights.SampleLevel(LinearSampler,(value*2048.0+0.5)/4097.0,0); }
+float4 SampleJinc2(Texture2D<float4> sourceTexture,float2 uv,uint2 dimensions) {
+    float2 position=uv*float2(dimensions)-0.5;
+    int2 origin=int2(floor(position));
+    float4 total=0.0; float weightTotal=0.0;
+    [loop] for(int y=-1;y<=2;++y) {
+        [loop] for(int x=-1;x<=2;++x) {
+            float2 delta=float2(origin+int2(x,y))-position;
+            float weight=Jinc2Weight(length(delta));
+            total+=LoadClamped(sourceTexture,origin+int2(x,y),dimensions)*weight;
+            weightTotal+=weight;
+        }
+    }
+    float4 result=total/max(abs(weightTotal),0.000001);
+    if((UpscaleAlgorithm & 65536)!=0) {
