+bool PlayerSession::CollectSoftwareVideoFrame() noexcept {
+    AVFrame* frame = nullptr;int result;
+    {
+        std::lock_guard lock(softwareVideoMutex_);
+        if (videoFrameQueue_.size() < VideoQueueLimit()) {
+            frame = softwareVideoOutput_;softwareVideoOutput_ = nullptr;
