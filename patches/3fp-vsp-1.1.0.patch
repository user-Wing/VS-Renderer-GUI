+}
+
+FFFResult PlayerSession::SetExternalOutputFormat(const char* format) noexcept {
+    const auto value = !format || !*format ? AV_PIX_FMT_NONE : av_get_pix_fmt(format);
+    if (format && *format && (value == AV_PIX_FMT_NONE || !sws_isSupportedOutput(value))) return FFFResult::NotSupported;
+    externalOutputFormat_.store(static_cast<int>(value));
+    return FFFResult::Success;
+}
+
+FFFResult PlayerSession::SubmitExternalVideoFrame(const FFF3FPExternalVideoFrame& source) noexcept {
+    if (source.size < sizeof(FFF3FPExternalVideoFrame) || source.version != 1 ||
+        source.width == 0 || source.height == 0 || source.data[0] == nullptr ||
+        source.linesize[0] <= 0 || source.frameIndex < 0 || source.totalFrames < 0 ||
+        source.colorRange > 2) return FFFResult::InvalidArgument;
+
+    const auto pixelFormat = ExternalPixelFormat(source.format);
+    if (pixelFormat == AV_PIX_FMT_NONE) return FFFResult::NotSupported;
+    const auto* descriptor = av_pix_fmt_desc_get(pixelFormat);
+    if (descriptor == nullptr) return FFFResult::NotSupported;
+    const auto planeCount = av_pix_fmt_count_planes(pixelFormat);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        if (source.data[plane] == nullptr || source.linesize[plane] <= 0)
+            return FFFResult::InvalidArgument;
+    }
+
+    AVFrame frame{};
+    frame.width = static_cast<int>(source.width);
+    frame.height = static_cast<int>(source.height);
+    frame.format = pixelFormat;
+    frame.pts = source.frameIndex;
+    frame.best_effort_timestamp = source.frameIndex;
+    frame.duration = 1;
+    frame.color_range = source.colorRange == 2 ? AVCOL_RANGE_JPEG :
+        (source.colorRange == 1 ? AVCOL_RANGE_MPEG : AVCOL_RANGE_UNSPECIFIED);
+    frame.color_primaries = static_cast<AVColorPrimaries>(source.colorPrimaries);
+    frame.color_trc = static_cast<AVColorTransferCharacteristic>(source.colorTransfer);
+    frame.colorspace = static_cast<AVColorSpace>(source.colorMatrix);
+    frame.chroma_location = static_cast<AVChromaLocation>(source.chromaLocation);
+    for (int plane = 0; plane < planeCount; ++plane) {
+        frame.data[plane] = static_cast<std::uint8_t*>(const_cast<void*>(source.data[plane]));
+        frame.linesize[plane] = source.linesize[plane];
+    }
+
+    AVFrame* owned=av_frame_alloc();
+    if(!owned) return FFFResult::NativeFailure;
+    owned->format=frame.format;owned->width=frame.width;owned->height=frame.height;
+    av_frame_copy_props(owned,&frame);
+    if(av_frame_get_buffer(owned,32)<0 || av_frame_copy(owned,&frame)<0){av_frame_free(&owned);return FFFResult::NativeFailure;}
+    AVFrame* converted = nullptr;
+    AVFrame* submitted = owned;
+    const auto target = static_cast<AVPixelFormat>(externalOutputFormat_.load());
+    if (target != AV_PIX_FMT_NONE && target != pixelFormat) {
+        converted = av_frame_alloc();
+        if (!converted) { av_frame_free(&owned); return FFFResult::NativeFailure; }
+        converted->width = frame.width; converted->height = frame.height; converted->format = target;
+        av_frame_copy_props(converted, &frame);
+        auto* scale = sws_getContext(frame.width, frame.height, pixelFormat, frame.width, frame.height, target, SWS_BICUBIC | SWS_ACCURATE_RND, nullptr, nullptr, nullptr);
+        if (!scale || av_frame_get_buffer(converted, 32) < 0) { sws_freeContext(scale); av_frame_free(&converted); av_frame_free(&owned); return FFFResult::NativeFailure; }
+        const int space = frame.colorspace == AVCOL_SPC_BT2020_NCL ? SWS_CS_BT2020 : frame.colorspace == AVCOL_SPC_BT470BG || frame.colorspace == AVCOL_SPC_SMPTE170M ? SWS_CS_ITU601 : SWS_CS_ITU709;
+        const int range = frame.color_range == AVCOL_RANGE_JPEG;
+        const auto* coefficients = sws_getCoefficients(space);
+        sws_setColorspaceDetails(scale, coefficients, range, coefficients, range, 0, 1 << 16, 1 << 16);
+        sws_scale(scale, frame.data, frame.linesize, 0, frame.height, converted->data, converted->linesize);
+        sws_freeContext(scale); submitted = converted;
+    }
+    const auto result = videoRenderer_.Render(submitted, source.frameIndex, false, false, false, false, nullptr, nullptr, true);
+    if (result == FFFResult::Success) RetainSourcePixelFrame(owned, 0);
+    av_frame_free(&converted);av_frame_free(&owned);
+    if (result != FFFResult::Success) {
+        if (result == FFFResult::DeviceFailure) videoRenderer_.RequestRecoveryIfDeviceLost();
+        return result;
+    }
+
+    state_.store(FFF3FPState::Paused);
+    FFF3FPSnapshot external{};
+    {
+        std::lock_guard lock(snapshotMutex_);
+        external = publishedSnapshot_;
+        external.size = sizeof(external);
+        external.version = 20;
+        external.state = FFF3FPState::Paused;
+        external.position100ns = source.duration100ns > 0 ? source.frameIndex * source.duration100ns : 0;
+        external.duration100ns = source.duration100ns > 0 ? source.totalFrames * source.duration100ns : 0;
+        external.frameIndex = source.frameIndex;
+        external.framePts = source.frameIndex;
+        external.frameTimeBaseNumerator = source.duration100ns > 0 ? static_cast<std::int32_t>(source.duration100ns) : 1;
+        external.frameTimeBaseDenominator = static_cast<std::int32_t>(TicksPerSecond);
+        external.videoWidth = source.width;
+        external.videoHeight = source.height;
+        external.decodedVideoFrames++;
+        external.actualColorMode = videoRenderer_.ActualColorMode();
+        external.sourcePeakNits = static_cast<std::uint32_t>(std::lround(videoRenderer_.SourcePeakNits()));
+        publishedSnapshot_ = external;
+    }
+    return FFFResult::Success;
+}
+
+FFFResult PlayerSession::SetAudioEffects(const bool enabled,const float* gains,const float wave,const std::int64_t delay) noexcept {
+    if(!gains || !std::isfinite(wave) || wave<0 || wave>1)return FFFResult::InvalidArgument;
+    std::array<float,10> values{};for(int i=0;i<10;++i){if(!std::isfinite(gains[i]) || gains[i]<-12 || gains[i]>12)return FFFResult::InvalidArgument;values[i]=gains[i];}
+    Enqueue([this,enabled,values,wave,delay]{
+        const bool shifted=audioDelay100ns_!=delay;
+        const bool reuse=tempoGraph_ && equalizerEnabled_==enabled && waveVolume_==wave && !shifted;
+        equalizerEnabled_=enabled;waveVolume_=wave;audioDelay100ns_=delay;
+        for(int i=0;i<10;++i)equalizerGains_[i]=values[i];
+        if(reuse) {
+            bool updated=true;
+            for(int i=0;enabled && i<10;++i){const auto name="eq"+std::to_string(i);if(!avfilter_graph_get_filter(tempoGraph_,name.c_str()))continue;const auto gain=std::to_string(values[i]);if(avfilter_graph_send_command(tempoGraph_,name.c_str(),"gain",gain.c_str(),nullptr,0,0)<0)updated=false;}
+            if(updated)return;
+        }
+        if(shifted && format_)DoSeek(snapshot_.position100ns);
+        else ResetTempo(audioRenderer_?audioRenderer_->Position100ns():snapshot_.position100ns);
+    });return FFFResult::Success;
+}
