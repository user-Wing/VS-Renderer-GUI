+FFFResult PlayerVideoRenderer::SetScalingAlgorithms(
+    const FFF3FPScalingAlgorithm upscale,
+    const FFF3FPScalingAlgorithm downscale) noexcept {
+    if ((static_cast<std::uint32_t>(upscale) & 255u) > 14u ||
+        ((static_cast<std::uint32_t>(upscale) >> 8) & 255u) > 11u ||
+        (static_cast<std::uint32_t>(upscale) >> 24) > 9u ||
+        static_cast<std::uint32_t>(downscale) > 8u)
+        return FFFResult::InvalidArgument;
+    std::lock_guard lock(deviceMutex_);
+    if ((static_cast<std::uint32_t>(upscale) & 255u) < 9u) anime4kFast_.reset();
