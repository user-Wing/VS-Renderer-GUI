+float Spline36Weight(float x) {
+    x=abs(x);
+    if(x<1)return ((13.0/11.0*x-453.0/209.0)*x-3.0/209.0)*x+1;
+    if(x<2){x-=1;return ((-6.0/11.0*x+270.0/209.0)*x-156.0/209.0)*x;}
+    if(x<3){x-=2;return ((1.0/11.0*x-45.0/209.0)*x+26.0/209.0)*x;}
+    return 0;
+}
+float GeneralCubic(float x,float B,float C) {
+    x=abs(x);
+    if(x<1)return ((12-9*B-6*C)*x*x*x+(-18+12*B+6*C)*x*x+6-2*B)/6;
+    if(x<2)return ((-B-6*C)*x*x*x+(6*B+30*C)*x*x+(-12*B-48*C)*x+8*B+24*C)/6;
+    return 0;
+}
+float4 SampleSeparable(Texture2D<float4> tex,float2 uv,uint2 dim,uint kernel) {
+    float2 pos=uv*dim-.5;int2 origin=int2(floor(pos));float4 sum=0;float norm=0;
+    [loop]for(int y=-2;y<=3;++y)[loop]for(int x=-2;x<=3;++x){
+        float2 d=float2(origin+int2(x,y))-pos;
+        float w=kernel==5?Spline36Weight(d.x)*Spline36Weight(d.y):
+            GeneralCubic(d.x,kernel==7?1.0:1.0/3.0,kernel==7?0.0:1.0/3.0)*GeneralCubic(d.y,kernel==7?1.0:1.0/3.0,kernel==7?0.0:1.0/3.0);
+        sum+=LoadClamped(tex,origin+int2(x,y),dim)*w;norm+=w;
+    }return sum/max(norm,.000001);
+}
+// Hyllian's MIT-licensed Super-XBR pass-0 diagonal kernel, adapted to D3D11.
+// This is intentionally exposed as the single-stage variant, not the 3-pass scaler.
+float XbrDistance(float c0,float c1,float c2,float d1,float d2,float e1,float e2,float e3) {
+    return abs(c1-c2)+abs(c1-c0)+abs(e2-e1)+abs(e2-e3)+2*abs(d1-d2)-abs(c0-c2)-abs(e1-e3);
+}
+float4 SampleSuperXbr(Texture2D<float4> tex,float2 uv,uint2 dim) {
+    float2 p=uv*dim;int2 o=int2(floor(p));
+    if(any(frac(p)<.5))return LoadClamped(tex,o,dim);
+    float4 P0=LoadClamped(tex,o+int2(-1,-1),dim),P1=LoadClamped(tex,o+int2(2,-1),dim);
+    float4 P2=LoadClamped(tex,o+int2(-1,2),dim),P3=LoadClamped(tex,o+int2(2,2),dim);
+    float4 B=LoadClamped(tex,o+int2(0,-1),dim),C=LoadClamped(tex,o+int2(1,-1),dim);
+    float4 D=LoadClamped(tex,o+int2(-1,0),dim),E=LoadClamped(tex,o,dim),F=LoadClamped(tex,o+int2(1,0),dim);
+    float4 G=LoadClamped(tex,o+int2(-1,1),dim),H=LoadClamped(tex,o+int2(0,1),dim),I=LoadClamped(tex,o+int2(1,1),dim);
+    float4 F4=LoadClamped(tex,o+int2(2,0),dim),I4=LoadClamped(tex,o+int2(2,1),dim);
+    float4 H5=LoadClamped(tex,o+int2(0,2),dim),I5=LoadClamped(tex,o+int2(1,2),dim);
+    float4 l=float4(.2126,.7152,.0722,0);
+    float edge=XbrDistance(dot(G,l),dot(E,l),dot(C,l),dot(H,l),dot(F,l),dot(H5,l),dot(I,l),dot(F4,l))-
+        XbrDistance(dot(B,l),dot(F,l),dot(I4,l),dot(E,l),dot(I,l),dot(D,l),dot(H,l),dot(I5,l));
+    float k=.129633;float4 a=-k*(P2+P1)+(k+.5)*(H+F),b=-k*(P0+P3)+(k+.5)*(E+I);
+    float4 result=lerp(a,b,smoothstep(-1.000001,1.000001,edge));
+    float4 correction=lerp((P2-H)*(F-P1),(P0-E)*(I-P3),step(0,edge));
+    return clamp(result,min(min(E,F),min(H,I))+correction,max(max(E,F),max(H,I))-correction);
+}
+float4 SampleBilateral(Texture2D<float4> tex,float2 uv,uint2 dim,bool guided) {
+    float2 pos=uv*dim-.5;int2 o=int2(floor(pos));float4 sum=0;float norm=0;
+    float4 center=tex.SampleLevel(LinearSampler,uv,0);
+    float guide=Source.SampleLevel(LinearSampler,uv-ChromaOffset,0).r;
+    [loop]for(int y=-1;y<=2;++y)[loop]for(int x=-1;x<=2;++x){
+        float2 d=float2(o+int2(x,y))-pos;float4 value=LoadClamped(tex,o+int2(x,y),dim);
+        float range=guided?Source.SampleLevel(LinearSampler,(float2(o+int2(x,y))+.5)/dim-ChromaOffset,0).r-guide:length(value-center);
+        float w=exp(-dot(d,d)*.5-range*range*200);sum+=value*w;norm+=w;
+    }return sum/max(norm,.000001);
+}
+float4 SampleChroma(Texture2D<float4> tex,float2 uv) {
+    uint w,h;tex.GetDimensions(w,h);uint2 dim=uint2(w,h);
+    uint algorithm=(UpscaleAlgorithm>>8)==0?1:(UpscaleAlgorithm>>8)-1;
+    if(algorithm==0)return tex.SampleLevel(PointSampler,uv,0);
+    if(algorithm==1)return tex.SampleLevel(LinearSampler,uv,0);
+    if(algorithm==2)return SampleBicubic(tex,uv,dim);
+    if(algorithm==3)return SampleLanczos3(tex,uv,dim,float2(w,h));
+    if(algorithm==4)return SampleJinc2(tex,uv,dim);
+    if(algorithm==5 || algorithm==7 || algorithm==8)return SampleSeparable(tex,uv,dim,algorithm);
+    if(algorithm==6)return SampleSuperXbr(tex,uv,dim);
+    return SampleBilateral(tex,uv,dim,algorithm==10);
+}
