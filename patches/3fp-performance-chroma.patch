+// Bytecode is device-independent; compile each built-in shader once per process.
+HRESULT CompileSharedShader(LPCVOID source, SIZE_T length, LPCSTR sourceName,
+    const D3D_SHADER_MACRO* defines, ID3DInclude* include, LPCSTR entry, LPCSTR target,
+    UINT flags, UINT effectFlags, ID3DBlob** code, ID3DBlob** errors) {
+    static std::mutex mutex;
+    static std::map<std::string, ComPtr<ID3DBlob>> cache;
+    std::lock_guard lock(mutex);
+    const std::string key = std::string(static_cast<const char*>(source), length) + target + entry;
+    const auto found = cache.find(key);
+    if (found != cache.end()) return found->second.CopyTo(code);
+    std::filesystem::path cachePath;
+    HMODULE module = nullptr;
+    wchar_t modulePath[32768]{};
+    if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+        reinterpret_cast<LPCWSTR>(&CompileSharedShader), &module) && GetModuleFileNameW(module, modulePath, 32768)) {
+        std::uint64_t hash = 14695981039346656037ull;
+        for (unsigned char c : key + "vsr-opt1-v1") { hash ^= c; hash *= 1099511628211ull; }
+        cachePath = std::filesystem::path(modulePath).parent_path() / L"shader-cache" / (std::to_wstring(hash) + L".cso");
+        ComPtr<ID3DBlob> cached;
+        if (SUCCEEDED(D3DReadFileToBlob(cachePath.c_str(), &cached))) {
+            cache.emplace(key, cached);
+            return cached.CopyTo(code);
+        }
+    }
+    // Level 1 avoids lengthy loop optimization at startup without changing kernels.
+    flags = (flags & ~D3DCOMPILE_OPTIMIZATION_LEVEL3) | D3DCOMPILE_OPTIMIZATION_LEVEL1;
+    const auto result = D3DCompile(source, length, sourceName, defines, include, entry,
+        target, flags, effectFlags, code, errors);
+    if (SUCCEEDED(result)) {
+        cache.emplace(key, *code);
+        if (!cachePath.empty()) {
+            std::error_code error;
+            std::filesystem::create_directories(cachePath.parent_path(), error);
+            if (!error) D3DWriteBlobToFile(*code, cachePath.c_str(), TRUE);
+        }
+    }
+    return result;
+}
