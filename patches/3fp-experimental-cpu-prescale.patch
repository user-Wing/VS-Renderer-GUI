+FFFResult PlayerSession::SetSoftwarePreScale(const std::int32_t height) noexcept {
+    if (height != 0 && height != 720 && height != 1080 && height != 2160)
+        return FFFResult::InvalidArgument;
+    softwarePreScaleHeight_.store(height);
+    return FFFResult::Success;
+}
+
+AVFrame* PlayerSession::PreScaleSoftwareFrame(AVFrame* frame) noexcept {
+    const auto height = softwarePreScaleHeight_.load();
+    if (height == 0 || frame->height <= height || IsHardwareFrame(frame)) return frame;
+    const auto width = std::max(2, static_cast<int>(static_cast<std::int64_t>(frame->width) * height / frame->height) & ~1);
+    auto* output = av_frame_alloc();
+    if (output == nullptr) return nullptr;
+    output->width = width;output->height = height;output->format = frame->format;
+    if (av_frame_get_buffer(output, 32) < 0) { av_frame_free(&output);return nullptr; }
+    if (softwarePreScaler_ == nullptr) softwarePreScaler_ = sws_alloc_context();
+    if (softwarePreScaler_ == nullptr) { av_frame_free(&output);return nullptr; }
+    av_opt_set_int(softwarePreScaler_, "threads", std::min(8u,std::max(1u,std::thread::hardware_concurrency())), 0);
+    av_opt_set_int(softwarePreScaler_, "sws_flags", SWS_BILINEAR | SWS_ACCURATE_RND, 0);
+    if (sws_scale_frame(softwarePreScaler_, output, frame) < 0 || av_frame_copy_props(output, frame) < 0) {
+        av_frame_free(&output);return nullptr;
+    }
+    return output;
+}
