+FFFResult PlayerVideoRenderer::SetColorSettings(const VsrColorSettings& settings) noexcept {
+    // Swap-chain changes use their original lock; do not nest the device mutex.
+    const auto result = SetColorMode(settings.output == 1 ? FFF3FPColorMode::MapToSdr : FFF3FPColorMode::MapToHdr,
+        settings.sdrPeak, settings.displayPeak, settings.paperWhite, settings.output == 2);
+    if (result != FFFResult::Success) return result;
+    std::lock_guard lock(deviceMutex_);
+    colorEngine_.configure(settings);
+    return FFFResult::Success; // Optional-engine errors are reported by color status; native keeps playing.
+}
+FFFResult PlayerVideoRenderer::GetColorStatus(VsrColorStatus& status) const noexcept {
+    if (status.size != sizeof(status) || status.version != 1) return FFFResult::InvalidArgument;
+    std::lock_guard lock(deviceMutex_);
+    status = colorEngine_.status();
+    status.outputHdr = swapHdr_; status.outputBits = swapOutputBits_;
+    return FFFResult::Success;
+}
