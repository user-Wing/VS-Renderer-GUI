 #include <chrono>
 
 namespace {
+// All remote inputs must pass through the GUI's checked loopback Range proxy.
+bool IsLoopbackProxy(const std::string_view path) noexcept {
+    constexpr std::string_view prefix="http://127.0.0.1:";
+    if(path.rfind(prefix,0)!=0 || path.find_first_of("\r\n")!=std::string_view::npos)return false;
+    const auto slash=path.find('/',prefix.size());
+    if(slash==std::string_view::npos || slash==prefix.size())return false;
+    unsigned port=0;
+    for(auto i=prefix.size();i<slash;++i){if(path[i]<'0' || path[i]>'9')return false;port=port*10+unsigned(path[i]-'0');if(port>65535)return false;}
+    return port>0;
+}
