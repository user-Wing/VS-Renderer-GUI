+            color.sarNumerator < 0 || color.sarDenominator < 0) return invalid();
+        if (color.fieldBased) owned->flags |= AV_FRAME_FLAG_INTERLACED;
+        if (color.fieldBased == 2) owned->flags |= AV_FRAME_FLAG_TOP_FIELD_FIRST;
+        if (color.sarNumerator > 0 && color.sarDenominator > 0)
+            owned->sample_aspect_ratio = AVRational{color.sarNumerator, color.sarDenominator};
+        if (color.presentationTime100ns >= 0) {
+            owned->pts = owned->best_effort_timestamp = color.presentationTime100ns;
+            owned->time_base = AVRational{1, 10000000};
+            owned->duration = source.duration100ns;
+        }
+        const auto signature = std::uint64_t(source.colorTransfer) |
+            (std::uint64_t(source.colorPrimaries) << 16) | (std::uint64_t(color.streamHdr10Plus) << 32);
+        if (signature != externalStreamSignature_ || source.frameIndex <= lastExternalFrame_) {
+            auto* stream = avcodec_parameters_alloc();
+            if (!stream) { av_frame_free(&owned); return FFFResult::NativeFailure; }
+            stream->codec_type = AVMEDIA_TYPE_VIDEO; stream->color_trc = owned->color_trc;
+            stream->color_primaries = owned->color_primaries; stream->color_space = owned->colorspace;
+            stream->color_range = owned->color_range; stream->chroma_location = owned->chroma_location;
+            if (color.streamHdr10Plus)
+                av_packet_side_data_new(&stream->coded_side_data, &stream->nb_coded_side_data,
+                    AV_PKT_DATA_DYNAMIC_HDR10_PLUS, 1, 0);
+            videoRenderer_.ConfigureHdrStream(stream);
+            avcodec_parameters_free(&stream);
+            externalStreamSignature_ = signature;
+        }
+        lastExternalFrame_ = source.frameIndex;
+
+    }
+    AVFrame* converted = nullptr;
+    AVFrame* submitted = owned;
+    if (target != AV_PIX_FMT_NONE && target != pixelFormat) {
+        const auto* outputDescriptor = av_pix_fmt_desc_get(target);
+        const bool sourceRgb = (descriptor->flags & AV_PIX_FMT_FLAG_RGB) != 0;
+        const bool targetRgb = outputDescriptor && (outputDescriptor->flags & AV_PIX_FMT_FLAG_RGB) != 0;
+        const bool sourceGray = descriptor->nb_components == 1;
+        const bool targetGray = outputDescriptor && outputDescriptor->nb_components == 1;
+        // A forced output format is an explicit conversion, never part of the
+        // identity path. swscale's matrix API cannot implement CL or YCgCo.
+        if (!outputDescriptor || sourceGray != targetGray ||
+            (!sourceRgb && (owned->colorspace == AVCOL_SPC_BT2020_CL || owned->colorspace == AVCOL_SPC_YCGCO))) {
+            av_frame_free(&owned); return FFFResult::NotSupported;
+        }
+        auto matrix = owned->colorspace;
+        int space = SWS_CS_ITU709;
+        switch (matrix) {
+        case AVCOL_SPC_RGB: case AVCOL_SPC_UNSPECIFIED:
+            matrix = AVCOL_SPC_BT709; break;
+        case AVCOL_SPC_BT709: break;
+        case AVCOL_SPC_BT470BG: case AVCOL_SPC_SMPTE170M: space = SWS_CS_ITU601; break;
+        case AVCOL_SPC_FCC: space = SWS_CS_FCC; break;
+        case AVCOL_SPC_SMPTE240M: space = SWS_CS_SMPTE240M; break;
+        case AVCOL_SPC_BT2020_NCL: space = SWS_CS_BT2020; break;
+        default: av_frame_free(&owned); return FFFResult::NotSupported;
+        }
+        const bool inputFull = sourceRgb || (sourceGray && owned->color_range != AVCOL_RANGE_MPEG) ||
+            owned->color_range == AVCOL_RANGE_JPEG;
+        const bool outputFull = targetRgb || (targetGray && inputFull) || target == AV_PIX_FMT_YUVJ420P ||
+            target == AV_PIX_FMT_YUVJ422P || target == AV_PIX_FMT_YUVJ444P ||
+            (!sourceRgb && owned->color_range == AVCOL_RANGE_JPEG);
+        converted = av_frame_alloc();
+        if (!converted) { av_frame_free(&owned); return FFFResult::NativeFailure; }
+        converted->width = owned->width; converted->height = owned->height; converted->format = target;
+        if (av_frame_copy_props(converted, owned) < 0) {
+            av_frame_free(&converted); av_frame_free(&owned); return FFFResult::NativeFailure;
+        }
+        converted->colorspace = targetRgb ? AVCOL_SPC_RGB : matrix;
+        converted->color_range = outputFull ? AVCOL_RANGE_JPEG : AVCOL_RANGE_MPEG;
+        if (targetRgb || targetGray) converted->chroma_location = AVCHROMA_LOC_UNSPECIFIED;
+        else if (sourceRgb) converted->chroma_location = outputDescriptor->log2_chroma_w ? AVCHROMA_LOC_LEFT : AVCHROMA_LOC_UNSPECIFIED;
+        auto* scale = sws_getContext(owned->width, owned->height, pixelFormat, owned->width, owned->height, target, SWS_BICUBIC | SWS_ACCURATE_RND, nullptr, nullptr, nullptr);
+        if (!scale || av_frame_get_buffer(converted, 32) < 0) { sws_freeContext(scale); av_frame_free(&converted); av_frame_free(&owned); return FFFResult::NativeFailure; }
+        const auto* coefficients = sws_getCoefficients(space);
+        const bool configured = sws_setColorspaceDetails(scale, coefficients, inputFull, coefficients, outputFull, 0, 1 << 16, 1 << 16) >= 0;
+        const int rows = configured ? sws_scale(scale, owned->data, owned->linesize, 0, owned->height, converted->data, converted->linesize) : -1;
+        sws_freeContext(scale);
+        if (rows != owned->height) { av_frame_free(&converted); av_frame_free(&owned); return FFFResult::FfmpegFailure; }
+        submitted = converted;
+    }
+    const auto result = videoRenderer_.Render(submitted, source.frameIndex, false, false, false, false, nullptr, nullptr, 0, 0, true);
+    if (result == FFFResult::Success) RetainSourcePixelFrame(owned, 0);
+    av_frame_free(&converted);av_frame_free(&owned);
+    if (result != FFFResult::Success) {
+        if (result == FFFResult::DeviceFailure) videoRenderer_.RequestRecoveryIfDeviceLost();
+        return result;
+    }
+
+    state_.store(FFF3FPState::Paused);
+    FFF3FPSnapshot external{};
+    {
+        std::lock_guard lock(snapshotMutex_);
+        external = publishedSnapshot_;
+        external.size = sizeof(external);
+        external.version = SnapshotVersion;
+        external.state = FFF3FPState::Paused;
+        external.position100ns = source.version == 2 && source.colorMetadata.presentationTime100ns >= 0 ?
+            source.colorMetadata.presentationTime100ns : source.duration100ns > 0 ? source.frameIndex * source.duration100ns : 0;
+        external.duration100ns = source.duration100ns > 0 ? source.totalFrames * source.duration100ns : 0;
+        external.frameIndex = source.frameIndex;
+        external.framePts = source.frameIndex;
+        av_reduce(&external.frameTimeBaseNumerator, &external.frameTimeBaseDenominator,
+            source.duration100ns > 0 ? source.duration100ns : 1, TicksPerSecond, INT_MAX);
+        if (source.version == 2 && source.colorMetadata.presentationTime100ns >= 0) {
+            external.framePts = source.colorMetadata.presentationTime100ns;
+            external.frameTimeBaseNumerator = 1;
+        }
+        external.videoWidth = source.width;
+        external.videoHeight = source.height;
+        external.decodedVideoFrames++;
+        external.actualColorMode = videoRenderer_.ActualColorMode();
+        external.sourcePeakNits = static_cast<std::uint32_t>(std::lround(videoRenderer_.SourcePeakNits()));
+        ApplyHdrState(external, videoRenderer_.StreamHdrState(), videoRenderer_.HdrState());
+        publishedSnapshot_ = external;
+    }
+    return FFFResult::Success;
+}
