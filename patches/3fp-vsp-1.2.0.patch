+            frame.format=FFF3FPExternalPixelFormat::Gray8;frame.data[0]=pixels;frame.linesize[0]=64;
+            if(s.SubmitExternalVideoFrame(frame)!=FFFResult::Success){
+                std::printf("SKIP atlas pressure: no usable D3D11 device/window\n");
+                s.DoClose();
+            }else{
+                auto command=[](std::uint64_t id){
+                    FFF3FPTimedTextCommand c{};c.size=sizeof(c);c.version=20;c.type=FFF3FPTimedTextCommandType::Text;
+                    c.width=32;c.height=20;c.fontSize=12;c.foregroundArgb=0xff000000u+static_cast<std::uint32_t>(id);c.contentId=id;
+                    c.textUtf8="A";c.fontFamilyUtf8="Arial";return c;
+                };
+                std::vector<FFF3FPTimedTextCommand> commands;
+                for(unsigned i=1;i<=256;++i)commands.push_back(command(i));
+                FFF3FPTimedTextLayer layer{};layer.size=sizeof(layer);layer.version=20;layer.canvasWidth=layer.canvasHeight=512;
+                layer.layerSlot=1;layer.targetFrameRate=30;
+                const auto draw=[&]{
+                    layer.commands=commands.data();layer.commandCount=static_cast<std::uint32_t>(commands.size());++layer.sequence;
+                    Check(s.SetTimedTextLayer(layer)==FFFResult::Success,"atlas layer accepted");
+                    Check(s.videoRenderer_.Redraw()==FFFResult::Success,"atlas pressure frame rendered");
+                    std::lock_guard lock(s.videoRenderer_.deviceMutex_);
+                    Check(s.videoRenderer_.DrawTimedText(TimedTextLayerSlot::Danmaku)==FFFResult::Success,
+                        "atlas GPU rasterization completed");
+                };
+                draw();
+                std::map<std::uint64_t,std::pair<float,float>> coordinates;
+                {
+                    std::lock_guard lock(s.videoRenderer_.deviceMutex_);
+                    for(const auto& [key,sprite]:s.videoRenderer_.timedTextSprites_)coordinates[key]={sprite.atlasX,sprite.atlasY};
+                }
+                Check(coordinates.size()==256,"atlas quota populated with distinct sprites");
+                for(unsigned i=257;i<=296;++i)commands.insert(commands.begin(),command(i));
+                draw();
+                {
+                    std::lock_guard lock(s.videoRenderer_.deviceMutex_);
+                    for(const auto& [key,xy]:coordinates){
+                        const auto found=s.videoRenderer_.timedTextSprites_.find(key);
+                        Check(found!=s.videoRenderer_.timedTextSprites_.end() &&
+                            found->second.atlasX==xy.first && found->second.atlasY==xy.second,
+                            "visible sprite retains atlas rectangle under churn");
+                    }
+                }
+                commands.clear();for(unsigned i=400;i<460;++i)commands.push_back(command(i));draw();
+                {
+                    std::lock_guard lock(s.videoRenderer_.deviceMutex_);
+                    Check(s.videoRenderer_.danmakuSpriteEvictions_>0 && s.videoRenderer_.danmakuSpriteCount_<=256,
+                        "stale atlas sprites reclaimed including pending allocations");
+                }
+                s.DoClose();
+            }
+        }
+        DestroyWindow(window);
+    }
