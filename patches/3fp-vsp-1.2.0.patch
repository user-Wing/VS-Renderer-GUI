+struct PlayerAudioSecurityRegression {
+    static void Run() {
+        PlayerWasapiRenderer renderer(L"");
+        renderer.outputSampleRate_=48000; renderer.outputChannels_=2;
+        renderer.outputBlockAlign_=8; renderer.outputBitsPerSample_=32; renderer.outputFloat_=true;
+        renderer.resetPosition100ns_.store(1000000);
+        AVFrame* frame=av_frame_alloc();frame->format=AV_SAMPLE_FMT_FLT;frame->sample_rate=48000;frame->nb_samples=480;
+        av_channel_layout_default(&frame->ch_layout,2);
+        Check(av_frame_get_buffer(frame,0)>=0,"preroll frame allocated");
+        std::memset(frame->data[0],0,480*8);
+        for(auto position : {700000LL,800000LL,900000LL}) {
+            Check(renderer.Enqueue(frame,position)==FFFResult::Success,"complete preroll frame accepted and trimmed");
+            Check(!renderer.timelineAnchored_ && renderer.queuedBytes_==0,"consecutive preroll frames cannot establish anchor");
+        }
+        Check(renderer.Enqueue(frame,1000000)==FFFResult::Success,"first target audio frame accepted");
+        Check(renderer.timelineAnchored_ && renderer.queuedBytes_>0,"first retained samples establish anchor");
+        Check(renderer.Enqueue(frame,INT64_MAX)==FFFResult::InvalidArgument,"audio huge timestamp gap rejected");
+        av_frame_free(&frame);
+    }
 };
 
