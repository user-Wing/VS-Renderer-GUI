# Build the C API with the same MinGW runtime as Qt. Only codec dependencies
# are fetched; tools, tests and JPEG transcoding are not part of our runtime.
find_package(Git REQUIRED)
set(vsr_jxl_source "${CMAKE_SOURCE_DIR}/.deps/image/libjxl-src")
if(NOT EXISTS "${vsr_jxl_source}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" clone --depth 1 --branch v0.12.0
        https://github.com/libjxl/libjxl.git "${vsr_jxl_source}" COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${vsr_jxl_source}" rev-parse HEAD
    OUTPUT_VARIABLE vsr_jxl_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT vsr_jxl_revision STREQUAL "a7a9c787341cf703dede03c2009fa460cae5e5df")
    message(FATAL_ERROR "Unexpected libjxl revision: ${vsr_jxl_revision}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${vsr_jxl_source}" submodule update --init --depth 1
    third_party/brotli third_party/highway third_party/lcms COMMAND_ERROR_IS_FATAL ANY)
function(vsr_build_jxl)
    set(BUILD_SHARED_LIBS OFF)
    set(BUILD_TESTING OFF)
    set(CMAKE_AUTOMOC OFF)
    foreach(option TOOLS DEVTOOLS BENCHMARK EXAMPLES JNI SJPEG OPENEXR SKCMS VIEWERS TCMALLOC PLUGINS DOXYGEN MANPAGES TRANSCODE_JPEG)
        set(JPEGXL_ENABLE_${option} OFF CACHE BOOL "" FORCE)
    endforeach()
    if(MINGW)
        # Avoid GCC 13/Win64's under-aligned indirect AVX argument stack slots
        # (PR54412). Inlining this vector helper removes the affected call ABI.
        set(writer "${vsr_jxl_source}/lib/jxl/render_pipeline/stage_write.cc")
        file(READ "${writer}" source)
        set(original "\nVFromD<Rebind<T, DF>> MakeUnsigned(")
        set(patched "\nHWY_INLINE VFromD<Rebind<T, DF>> MakeUnsigned(")
        string(FIND "${source}" "${original}" original_at)
        string(FIND "${source}" "${patched}" patched_at)
        if(original_at GREATER_EQUAL 0)
            string(REPLACE "${original}" "${patched}" source "${source}")
            file(WRITE "${writer}" "${source}")
        elseif(patched_at LESS 0)
            message(FATAL_ERROR "Review the libjxl Win64 SIMD inline patch")
        endif()
        # PR54412 also affects vector arguments through the DequantBlock function
        # pointer. Its two vectors are splats: pass scalar factors across the ABI
        # and reconstruct the same vectors inside the callee, retaining SIMD.
        set(group "${vsr_jxl_source}/lib/jxl/dec_group.cc")
        file(READ "${group}" source)
        set(group_before "${source}")
        string(REPLACE "void DequantLane(" "HWY_INLINE void DequantLane(" source "${source}")
        string(REPLACE "HWY_INLINE HWY_INLINE" "HWY_INLINE" source "${source}")
        set(original "float b_dm_multiplier, Vec<D> x_cc_mul, Vec<D> b_cc_mul,")
        set(patched "float b_dm_multiplier, float x_cc_factor, float b_cc_factor,")
        string(FIND "${source}" "${original}" original_at)
        string(FIND "${source}" "${patched}" patched_at)
        if(original_at GREATER_EQUAL 0)
            string(REPLACE "${original}" "${patched}" source "${source}")
            string(REPLACE "  const auto scaled_dequant_s = inv_global_scale / quant;"
                "  const auto x_cc_mul = Set(d, x_cc_factor);\n  const auto b_cc_mul = Set(d, b_cc_factor);\n  const auto scaled_dequant_s = inv_global_scale / quant;" source "${source}")
            string(REPLACE "dec_state->b_dm_multiplier, x_cc_mul, b_cc_mul, acs.Strategy(),"
                "dec_state->b_dm_multiplier, GetLane(x_cc_mul), GetLane(b_cc_mul), acs.Strategy()," source "${source}")
        elseif(patched_at LESS 0)
            message(FATAL_ERROR "Review the libjxl Win64 dequantization ABI patch")
        endif()
        if(NOT source STREQUAL group_before)
            file(WRITE "${group}" "${source}")
        endif()
    endif()
    add_subdirectory("${vsr_jxl_source}" "${CMAKE_BINARY_DIR}/image-jxl" EXCLUDE_FROM_ALL)
endfunction()
vsr_build_jxl()
qt_add_library(vsr_jxl STATIC src/image/ImageJxl.cpp src/image/ImageJxl.h)
target_include_directories(vsr_jxl PUBLIC src)
target_link_libraries(vsr_jxl PUBLIC Qt6::Gui PRIVATE jxl jxl_threads)
