    return HOOKED_raw.SampleLevel(_HOOKED_raw_sampler, uv, 0.0f) - (current_luma - new_luma).xxxx;
}

void frag_main()
{
    float4 v = hook();
    outColor = v;
}

SPIRV_Cross_Output main(SPIRV_Cross_Input stage_input)
{
    uv = stage_input.uv;
    frag_main();
    SPIRV_Cross_Output stage_output;
    stage_output.outColor = outColor;
    return stage_output;
}

